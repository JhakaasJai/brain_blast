# -----------------------------------------------------------------------------
# AI & TRANSLATION (Bhashini)
# -----------------------------------------------------------------------------

# BHASHINI_API_KEY: Key for Government/Indic language translation, TTS, STT.
# Found in your Bhashini account developer dashboard.
BHASHINI_API_KEY=your_bhashini_api_key

# BHASHINI_USER_ID: Sometimes required along with the API key depending on the endpoint.
BHASHINI_USER_ID=your_bhashini_user_id


# -----------------------------------------------------------------------------
# ESSENTIAL SERVICES (100% Free Tier Options)
# -----------------------------------------------------------------------------

# CLOUDINARY_URL: For media storage (e.g., Reminiscence therapy audio/images).
# Found in Cloudinary Dashboard -> Account Details -> API Environment variable.
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# RESEND_API_KEY: For sending real email notifications (replacing simulated SMS/Push for free).
# Found in Resend Dashboard -> API Keys
RESEND_API_KEY=your_resend_api_key
